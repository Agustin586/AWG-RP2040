/*
 * Parallel 8080 8-bit (bit-bang) + ILI9341 para NUCLEO-H755ZI-Q
 * Shield Arduino tipo MCUFRIEND 2.4"/2.8"
 *
 * Señal   | Arduino | GPIO
 * --------|---------|-------
 * DB0     | D8      | PG9
 * DB1     | D9      | PD15
 * DB2     | D2      | PG14
 * DB3     | D3      | PE13
 * DB4     | D4      | PE14
 * DB5     | D5      | PE11
 * DB6     | D6      | PA8
 * DB7     | D7      | PG12
 * WR      | A1      | PC0
 * CS      | A3      | PB1
 * RESET   | A4      | PC2
 * DC/RS   | A2      | PC3
 * RD      | A0      | PA3
 *
 * arduino_header índices: A0=0,A1=1,A2=2,A3=3,A4=4,A5=5
 *                         D0=6,D1=7,D2=8,...D8=14,D9=15,...D13=19
 */


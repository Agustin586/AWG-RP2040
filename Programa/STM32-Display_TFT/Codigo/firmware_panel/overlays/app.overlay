/*
 * El board support de Zephyr asigna green_led a PA5 (D13), pero en la
 * NUCLEO-H755ZI-Q (144 pines) el LED físico LD1 está en PB0.
 * Se sobreescribe el nodo aquí para corregirlo.
 */
&green_led {
	gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
};

/ {
	aliases {
		led0 = &green_led;
		led1 = &yellow_led;
		led2 = &red_led;
		sw0 = &user_button;
	};
};